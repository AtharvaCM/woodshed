{
  "name": "woodshed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WOODSHED — a browser practice room for e-drummers (Roland TD-07 first): play songs on a highway, build charts from any track, loop the hard bars. Forked from DRUMKILLER.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo-song": "node scripts/make-demo-song.mjs",
    "e2e": "node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
